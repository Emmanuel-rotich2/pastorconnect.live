# FGCK Joyland - server environment configuration
# Do NOT commit real credentials to source control.
FGCK_EMAIL_ENABLED=true
FGCK_SMTP_HOST=smtp.gmail.com
FGCK_SMTP_PORT=587
FGCK_SMTP_ENCRYPTION=tls
FGCK_SMTP_USERNAME=
FGCK_SMTP_PASSWORD=
FGCK_EMAIL_FROM=noreply@pastorconnect.live
FGCK_EMAIL_FROM_NAME=FGCK Makutano West Joyland Appointment System
FGCK_EMAIL_REPLY_TO=noreply@pastorconnect.live
FGCK_APP_URL=https://pastorconnect.live

# Database connection settings required on the hosting server.
FGCK_DB_HOST=localhost
FGCK_DB_PORT=3306
FGCK_DB_NAME=your_database_name
FGCK_DB_USER=your_database_user
FGCK_DB_PASSWORD=your_database_password
